{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.tsx",
    "desktop/**/*.ts",
    "desktop/**/*.tsx",
    "*.ts",
    "tests/**/*.ts"
  ]
}
