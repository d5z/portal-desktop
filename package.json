{
  "name": "portal-desktop",
  "productName": "Portal Desktop",
  "version": "0.1.12",
  "description": "A desktop home for your Being, with Heart Portal built in.",
  "author": "Beings contributors",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "test:plugin-network": "node tests/plugin-network-electron.mjs",
    "test:plugins-ui": "npm run build:chat && node tests/plugins-electron.mjs",
    "build:web:static": "node scripts/build-web-static.mjs",
    "package:web:static": "node scripts/package-web-static.mjs",
    "dev:web": "vite --config vite.web.config.mjs",
    "build:web": "node scripts/build-web.mjs",
    "package:web": "node scripts/package-web.mjs",
    "start:web": "node out/web/server.mjs",
    "start": "npm run prepare:desktop && electron-forge start",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "build:portal": "node scripts/build-portal.mjs",
    "package": "npm run build:portal && npm run prepare:desktop && electron-forge package",
    "make": "npm run build:portal && npm run prepare:desktop && node scripts/make-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "node scripts/test-all.mjs",
    "test:e2e": "node tests/electron-smoke.mjs",
    "test:workspace-ui": "npm run build:chat && node tests/workspace-layout.mjs",
    "test:settings-navigation": "node tests/settings-navigation.mjs",
    "test:message-flow": "npm run build:chat && node tests/chat-message-flow.mjs",
    "test:chat-surface-interaction": "node tests/chat-surface-interaction.mjs",
    "test:ui-interaction": "node tests/ui-interaction.mjs",
    "test:pdf-preview": "node tests/pdf-preview.mjs",
    "test:town-ui": "node tests/town-ui.mjs",
    "test:town-civic": "node tests/town-civic.mjs",
    "test:portal-e2e": "node tests/portal-runtime-e2e.mjs",
    "test:client-lifecycle": "node tests/client-lifecycle.mjs",
    "test:macos-package": "PORTAL_DESKTOP_MAC_PACKAGE_TESTS=1 vitest run tests/macos-package.test.ts",
    "test:macos-upgrade": "node tests/macos-upgrade-e2e.mjs",
    "test:windows-upgrade": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-upgrade.ps1",
    "test:taskbar-icons": "node tests/taskbar-icons-native.mjs",
    "test:town-sdk": "node tests/town-sdk.mjs",
    "test:portal-permissions": "node tests/portal-permissions-native.mjs",
    "test:notifications": "node tests/notifications-electron.mjs",
    "test:menu-keyboard": "node tests/menu-keyboard.mjs",
    "test:logs-ui": "npm run build:chat && node tests/logs-electron.mjs",
    "test:update-progress": "node tests/update-progress.mjs",
    "test:town-names": "node tests/town-names.mjs",
    "test:seed-garden": "node tests/seed-garden.mjs",
    "test:sbs-refresh": "npm run prepare:desktop && node tests/sbs-refresh.mjs",
    "test:recent-history": "node tests/recent-chat-history-ui.mjs",
    "test:browser": "node tests/browser-e2e.mjs",
    "build:chat": "node scripts/build-chat.mjs",
    "test:model-catalog": "node tests/model-catalog-ui.mjs",
    "test:attachments-ui": "npm run build:chat && node tests/attachments-electron.mjs",
    "test:chat-react": "npm run build:chat && node tests/chat-react.mjs",
    "test:chat-layout": "npm run build:chat && node tests/chat-layout.mjs",
    "test:chat-scroll": "npm run build:chat && node tests/chat-scroll.mjs",
    "test:local-file-preview": "node tests/local-file-preview-electron.mjs",
    "test:chat-context-menu": "npm run build:chat && node tests/chat-context-menu.mjs",
    "test:chat-send-queue": "npm run build:chat && node tests/chat-send-queue.mjs",
    "test:chat-sessions": "npm run build:chat && node tests/chat-sessions-electron.mjs",
    "test:client-context": "npm run build:chat && node tests/client-context-electron.mjs",
    "test:intelligent-ui-surfaces": "npm run build:chat && node tests/intelligent-ui-surfaces.mjs",
    "test:chat-history": "npm run build:chat && node tests/chat-history.mjs",
    "test:chat-history-target": "npm run build:chat && node tests/chat-history-target.mjs",
    "test:chat-scene-loading": "npm run build:chat && node tests/chat-scene-loading.mjs",
    "test:chat-render-performance": "npm run build:chat && node tests/chat-render-performance.mjs && node tests/chat-lazy-resources.mjs",
    "test:chat-history-recovery": "npm run build:chat && node tests/history-cache.mjs && node tests/chat-history-recovery.mjs && node tests/chat-history-window.mjs",
    "test:plugins-packaged": "npm run build:chat && node tests/plugins-electron.mjs --packaged",
    "lint:chat-hooks": "eslint desktop/renderer/chat/page.tsx desktop/renderer/chat/hooks desktop/renderer/chat/components/navigation.tsx desktop/renderer/shared/hooks/use-menu-dismiss.ts desktop/renderer/shared/components/message-menu.tsx desktop/renderer/shared/components/context-menu.tsx --max-warnings=0",
    "test:chat-hooks": "node tests/chat-hooks.mjs",
    "test:town-feed-layout": "node tests/town-feed-layout.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "playwright": "^1.58.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.3.0",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "ahooks": "^3.11.0",
    "exceljs": "^4.4.0",
    "highlight.js": "11.11.1",
    "marked": "^15.0.12",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.8.0",
    "tar": "^7.5.22"
  }
}
