    "test:dsh-ui": "npm run build:chat && node scripts/build-dsh-host.mjs && node tests/dsh-plugins-electron.mjs",
    "test:dsh-community": "npm run build:chat && node scripts/build-dsh-host.mjs && node tests/dsh-community-electron.mjs",
    "lint:styles": "stylelint \"desktop/renderer/**/*.scss\" \"web/**/*.scss\" --max-warnings=0",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "check:styles": "node scripts/check-styles.mjs",
    "format:styles": "prettier --write \"desktop/renderer/**/*.scss\" \"web/**/*.scss\" --single-quote --print-width 100",
    "format:styles:check": "prettier --check \"desktop/renderer/**/*.scss\" \"web/**/*.scss\" --single-quote --print-width 100",
    "test:web-styles": "npm run build:web && node tests/web-styles.mjs",
    "test:dsh-pet-host": "node tests/dsh-pet-host.mjs"
  },
